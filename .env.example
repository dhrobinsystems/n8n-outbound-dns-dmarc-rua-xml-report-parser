# =====================================================================================
# n8n-outbound-dns-dmarc-rua-xml-report-parser :: environment template
# Full text: DISCLAIMER.md · Licensed under the MIT License. License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
#
# Copy to `.env`, fill in your own values and NEVER commit the real file (.gitignore excludes it).
# Every value below is an anonymized placeholder. Domains use example.com / example.net,
# IPs use documentation ranges (RFC 5737 / RFC 3849).
# =====================================================================================

# -------------------------------------------------------------------------------------
# n8n runtime
# -------------------------------------------------------------------------------------
# Required: the Code / HTTP nodes read configuration through $env.
# n8n 2.x blocks env access by default, so this must be set explicitly.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC
TZ=UTC
# Keeps decompressed report binaries off the heap (recommended for large reports).
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
# Encryption key for stored n8n credentials. Generate your own random value (e.g. `openssl rand -hex 32`).
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# -------------------------------------------------------------------------------------
# IMAP mailbox that receives the DMARC rua reports
# n8n does not read these directly: enter them in the "IMAP - DMARC RUA Inbox" credential
# (or inject them with CREDENTIALS_OVERWRITE_DATA, see README > IMAP setup).
# -------------------------------------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=dmarc-reports@example.com
IMAP_PASSWORD=your_imap_password_here

# -------------------------------------------------------------------------------------
# Delivery
# -------------------------------------------------------------------------------------
# true  = parse + classify only, results stop at "Sandbox Preview (No Delivery)". Nothing is sent.
# false = live: post to dashboard webhook and send alerts.
# Unset or empty is treated as true (fail-safe).
SANDBOX_MODE=true

# Receives one JSON event per report / failure (POST). The auth header value lives in the
# n8n "Dashboard Webhook Auth" Header Auth credential, not here.
DASHBOARD_WEBHOOK_URL=https://dashboard.example.com/webhook/your_dashboard_webhook_here
# Reference only: paste into the Header Auth credential (Name: Authorization, Value: Bearer <token>).
DASHBOARD_WEBHOOK_TOKEN=your_dashboard_token_here

# Alert destination (Slack-compatible incoming webhook or your own endpoint).
ALERT_WEBHOOK_URL=https://hooks.example.com/services/your_alert_webhook_here
# Optional separate channel for workflow-level errors. Falls back to ALERT_WEBHOOK_URL.
ERROR_ALERT_WEBHOOK_URL=
# slack   -> {"text": "..."}
# generic -> {"text": "...", "event_type": "...", "report_key": "...", "event": {...}}
ALERT_PAYLOAD_FORMAT=slack

# -------------------------------------------------------------------------------------
# Detection & scoring
# -------------------------------------------------------------------------------------
# Comma-separated domains you own. Reports for other domains are logged with in_scope=false and
# never alerted. Leave empty to treat every report as in scope.
DOMAIN_WATCHLIST=example.com,example.net

# Your legitimate sending infrastructure: IPv4/IPv6 addresses or CIDRs, comma-separated.
# Include your MTAs, ESPs, CRM/marketing platforms and ticketing tools.
AUTHORIZED_SENDER_IPS=192.0.2.0/27,192.0.2.40,2001:db8:10::/48

# Minimum DMARC-failing messages from one unlisted IP (per report) before it is classed as
# unauthorized_spoofing. Below this it is unauthorized_low_volume (warning, no alert).
SPOOF_MIN_MESSAGES=5

# Legitimate-traffic DMARC pass rate thresholds (percent).
HEALTH_WARN_THRESHOLD=98
HEALTH_CRITICAL_THRESHOLD=90

# Alert switches
ALERT_ON_SPOOFING=true
ALERT_ON_WARNING=false
ALERT_ON_PARSE_FAILURE=true
MAX_SPOOF_SOURCES_IN_ALERT=10

# -------------------------------------------------------------------------------------
# Safety limits
# -------------------------------------------------------------------------------------
# Max decompressed XML size accepted per report (bytes). Default 25 MiB.
MAX_XML_BYTES=26214400
